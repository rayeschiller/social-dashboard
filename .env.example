# Copy to .env.local (gitignored) and fill in. Never commit real secrets.

# --- Database -------------------------------------------------------------
# Dev database (used by the app, `npm run migrate` and `npm run sync`).
DATABASE_URL=postgres://social_dashboard:social_dashboard_dev@localhost:5432/social_dashboard
# Test database. Tests TRUNCATE every table, so this MUST be a separate database
# whose name contains "test". The test runner refuses to start otherwise.
TEST_DATABASE_URL=postgres://social_dashboard:social_dashboard_dev@localhost:5432/social_dashboard_test

# --- Instagram API with Instagram Login -----------------------------------
# Instagram app ID / secret from App Dashboard > Instagram > API setup with Instagram login.
IG_APP_ID=
IG_APP_SECRET=
# Must EXACTLY match one of the "OAuth redirect URIs" configured in the App Dashboard.
IG_REDIRECT_URI=http://localhost:3000/api/auth/instagram/callback
# REQUIRED (no default): the username of the one account this dashboard tracks. Sync and OAuth
# refuse to run without it. The first successful sync/connect of this username pins the account's
# stable id; afterwards only that id is accepted (see README "Tracked account").
IG_EXPECTED_USERNAME=rayeschiller
# Optional: pin the stable IG user id up front (GET /me user_id) instead of on first sync.
IG_EXPECTED_USER_ID=
# Graph API version. v27.0 was the latest listed in Meta's reference pages on 2026-11-15.
IG_API_VERSION=v27.0

# How the client obtains a token:
#   auto  (default) IG_ACCESS_TOKEN if set, else the newest stored OAuth token, else fail with no_token
#   db    only the encrypted token stored by the OAuth flow
#   env   only IG_ACCESS_TOKEN
#   proxy an outbound proxy injects "Authorization: Bearer <token>" on graph.instagram.com;
#         the client sends a placeholder value that the proxy replaces
IG_AUTH_MODE=auto
IG_ACCESS_TOKEN=

# --- Secrets ----------------------------------------------------------------
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts OAuth tokens at rest (AES-256-GCM).
TOKEN_ENCRYPTION_KEY=
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/sync.
CRON_SECRET=

# --- Dashboard login ------------------------------------------------------------
# Single-user password for the dashboard. Without it every page/API answers 503 (fail closed).
DASHBOARD_PASSWORD=
# Signs the session cookie (HMAC-SHA256). At least 32 characters: openssl rand -hex 32
SESSION_SECRET=
# Local development only: DASHBOARD_AUTH=disabled turns the login off. Ignored (503) in production.
# DASHBOARD_AUTH=disabled

# --- Goal / reporting ---------------------------------------------------------
GOAL_FOLLOWERS=100000
GOAL_DEADLINE=2026-12-31
REPORTING_TIMEZONE=America/New_York
